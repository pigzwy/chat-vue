# ===== Sub2API 网关 =====
# 网关地址(必填,服务端所有聊天/图片/视频请求都走它)。三种形态:
#   公网:      https://sub2.pigcoder.com
#   宿主端口:  http://host.docker.internal:8080   (网关容器在同机、端口发布在宿主)
#   容器网络:  http://<网关容器名>:8080           (chat-vue 已声明加入 app-shared
#              外部网络,直接写网关容器名即可;无需再手动 docker network connect)
SUB2API_BASE_URL=
# 开发时 Vite 代理目标（一般与上面相同；也是服务端的兜底值）
VITE_SUB2API_BASE_URL=
# Vercel AI Gateway key（可选，无 Sub2API token 时聊天的回退通道）
AI_GATEWAY_API_KEY=

# ===== 创作台分组(React 版,运行时注入,改完 docker compose up -d 即生效) =====
# GPT Image 2 所在分组 id(不填用内置默认 25)
MEDIA_GROUP_OPENAI=
# Grok 画图/视频所在分组 id(不填用内置默认 66)
MEDIA_GROUP_GROK=
# Nano Banana(gemini-*-flash-image)所在分组 id(不填则该系不启用)
MEDIA_GROUP_NANOBANANA=

# ===== 端口与镜像 =====
# 对外端口(反向代理指向它;React 版由 web 容器承接)
APP_PORT=3009
# Vue 界面的本机回环排障/回滚口
LEGACY_PORT=3010

# ===== 其他 =====
# 媒体任务错误日志查询接口的口令（可选；不配置则 /api/admin/errors 关闭）
ADMIN_LOG_KEY=
