# ===== Sub2API 网关 =====
# 网关地址(必填,服务端所有聊天/图片/视频请求都走它)。三种形态:
#   公网:      https://pigcode.ai
#   宿主端口:  http://host.docker.internal:8080   (网关容器在同机、端口发布在宿主)
#   容器网络:  http://<网关容器名>:8080           (chat-vue 已声明加入 app-shared
#              外部网络,直接写网关容器名即可;无需再手动 docker network connect)
SUB2API_BASE_URL=
# 开发时 Vite 代理目标（一般与上面相同；也是服务端的兜底值）
VITE_SUB2API_BASE_URL=
# Vercel AI Gateway key（可选，无 Sub2API token 时聊天的回退通道）
AI_GATEWAY_API_KEY=

# ===== 创作台分组(React 版,运行时注入,改完 docker compose up -d 即生效) =====
# GPT Image 2 所在分组 id(不填用内置默认 25)
MEDIA_GROUP_OPENAI=
# Grok 画图/视频所在分组 id(不填用内置默认 66)
MEDIA_GROUP_GROK=
# Nano Banana(gemini-*-flash-image)所在分组 id(不填则该系不启用)
MEDIA_GROUP_NANOBANANA=

# ===== 登录形态(React 版) =====
# 网关站点根(必配):登录页直接用 Pigcode 账号密码登录(走网关公开 auth API,
# 自带静默续签);注册/忘记密码/充值明细都跳到该站点。网关开了 Turnstile 时,
# 需在 Cloudflare Turnstile 的域名白名单里加上本应用的域名
GATEWAY_ORIGIN=https://pigcode.ai
# 网关免登录接力入口(可选,需网关部署 /connect/studio 路由)。配置后:
# ① 无会话首开自动跳去探测,已登录网关即秒进(零点击 SSO,每标签页最多探测一次)
# ② 登录页额外展示「已在网关登录?一键进入」
# 例:SSO_CONNECT_URL=https://pigcode.ai/connect/studio
SSO_CONNECT_URL=

# ===== 端口与镜像 =====
# 对外端口(反向代理指向它;React 版由 web 容器承接)
APP_PORT=3009

# ===== 生图链路 =====
# 异步生图(网关 /v1/images/generations/async):1=开启。开启后服务端先提交异步
# 任务再轮询(上限 30 分钟),完成即下载 S3 预签名图转 b64 交给前端本地持久化;
# 网关未部署该端点时自动回退旧同步路径(404 探测,10 分钟记忆)。默认关闭。
SUB2API_ASYNC_IMAGES=
# 账号级生成历史里 S3 预签名 URL 的有效期(小时,用于展示倒计时),默认 168
MEDIA_URL_TTL_HOURS=

# ===== 其他 =====
# 媒体任务错误日志查询接口的口令（可选；不配置则 /api/admin/errors 关闭）
ADMIN_LOG_KEY=
