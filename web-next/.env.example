# web-next 环境变量说明(真实值放 .env,已 gitignore)

# 迁移期后端桥接:/api/* 与 /sub2api/* 代理到 Nitro 服务(见 src/lib/backend-proxy.ts)
BACKEND_ORIGIN=http://localhost:3000

# HeroUI Pro 许可(https://heroui.pro/dashboard):
# AUTH_TOKEN 供 @heroui-pro/react postinstall 拉取组件源码(install/CI 必需);
# PERSONAL_TOKEN 供技能包/MCP 使用。均不可暴露给浏览器(禁止 NEXT_PUBLIC_/VITE_ 前缀)。
HEROUI_AUTH_TOKEN=
HEROUI_PERSONAL_TOKEN=
